# Copy this file to .env and fill in real values. Never commit .env.
# RevenueCat public SDK keys (non-secret, embedded in the app binary).
# Get them from the RevenueCat dashboard -> your project -> App settings -> API keys.
# NOTE: the app treats the <PLACEHOLDER> values as "not configured" and skips
# RevenueCat initialization until real keys are provided.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_<PLACEHOLDER>
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_<PLACEHOLDER>
