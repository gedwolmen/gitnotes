{
  "expo": {
    "name": "GitNotes",
    "slug": "gitnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gitnotes.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gitnotes.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-auth-session",
        {
          "github": {
            "clientId": "YOUR_GITHUB_CLIENT_ID",
            "redirectUrl": "gitnotes://oauth/github"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "gitnotes-app"
      }
    },
    "owner": "vidwadeseram",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/gitnotes-app"
    }
  }
}
