{
  "expo": {
    "name": "GitNotē",
    "slug": "gitnotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xaventra.gitnotes",
      "scheme": "gitnotes",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GitNotes needs access to your photo library to attach images to notes.",
        "NSMicrophoneUsageDescription": "GitNotes needs access to your microphone for voice-to-text note input.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gitnotes.app",
      "scheme": "gitnotes",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007AFF"
        }
      ],
      "expo-image-picker",
      "@react-native-community/datetimepicker"
    ],
    "owner": "vidwa",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "af214cbc-3668-4913-9ea4-7227bc068a96"
      }
    }
  }
}
