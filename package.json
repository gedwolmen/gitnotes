{
  "name": "gitnotes",
  "version": "1.0.4",
  "license": "MPL-2.0",
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ts:check": "tsc --noEmit",
    "test": "jest",
    "e2e:ios:smoke": "maestro test e2e/ios/smoke",
    "e2e:ios:full": "maestro test e2e/ios/smoke e2e/ios/full",
    "e2e:android:smoke": "maestro test e2e/android/smoke",
    "e2e:android:full": "maestro test e2e/android/smoke e2e/android/full",
    "e2e:seed": "npx ts-node e2e/scripts/seed.ts",
    "e2e:reset": "npx ts-node e2e/scripts/reset-app.ts",
    "e2e:testid:validate": "npx ts-node e2e/scripts/validate-testids.ts",
    "e2e:coverage:validate": "npx ts-node e2e/scripts/validate-coverage.ts",
    "e2e:ios:boot": "bash e2e/scripts/boot-ios-simulator.sh",
    "prepare": "husky",
    "ios:fix-icon": "bash scripts/strip-icon-alpha.sh"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2",
    "@expo/vector-icons": "^15.0.3",
