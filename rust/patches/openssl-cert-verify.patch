diff --git a/libgit2/src/libgit2/streams/openssl.c b/libgit2/src/libgit2/streams/openssl.c
--- a/libgit2/src/libgit2/streams/openssl.c
+++ b/libgit2/src/libgit2/streams/openssl.c
@@ -377,8 +377,14 @@ static int verify_server_cert(SSL *ssl, const char *host)
 	void *addr = NULL;
 	int i = -1, j, error = 0;
 
 	if (SSL_get_verify_result(ssl) != X509_V_OK) {
-		git_error_set(GIT_ERROR_SSL, "the SSL certificate is invalid");
-		return GIT_ECERTIFICATE;
+		/* Skip certificate verification check when SSL_VERIFY_NONE is set.
+		 * On Android (Conscrypt), SSL_VERIFY_NONE does not prevent Conscrypt's
+		 * own Java-layer certificate chain validation, which stores its result
+		 * in the SSL session. When Conscrypt rejects the chain, we still want
+		 * the connection to succeed since SSL_VERIFY_NONE means "don't verify". */
+		if (SSL_CTX_get_verify_mode(SSL_get_SSL_CTX(ssl)) != SSL_VERIFY_NONE) {
+			git_error_set(GIT_ERROR_SSL, "the SSL certificate is invalid");
+			return GIT_ECERTIFICATE;
+		}
 	}
 
 	/* Try to parse the host as an IP address to see if it is */
@@ -714,12 +720,29 @@ int git_openssl__set_cert_location(const char *file, const char *path)
 	if (openssl_ensure_initialized() < 0)
 		return -1;
 
 	if (SSL_CTX_load_verify_locations(git__ssl_ctx, file, path) == 0) {
 		char errmsg[256];
 		ERR_error_string_n(ERR_get_error(), errmsg, sizeof(errmsg));
 
-		git_error_set(GIT_ERROR_SSL, "OpenSSL error: failed to load certificates: %s",
-			errmsg);
-		return -1;
+		/* If file mode fails (e.g. "no-stdio" OpenSSL build), try directory mode
+		 * if a directory was also provided. This handles Android where OpenSSL's
+		 * file-mode fails but directory mode works. */
+		if (file != NULL && path != NULL) {
+			if (SSL_CTX_load_verify_locations(git__ssl_ctx, NULL, path) == 0) {
+				git_error_set(GIT_ERROR_SSL, "OpenSSL error: failed to load certificates: %s",
+					errmsg);
+				return -1;
+			}
+			/* Directory mode succeeded. */
+			return 0;
+		}
+
+		git_error_set(GIT_ERROR_SSL, "OpenSSL error: failed to load certificates: %s",
+			errmsg);
+		return -1;
 	}
 	return 0;
 }
